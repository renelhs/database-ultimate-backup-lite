<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Backup Scheduler Cron Job -->
        <record id="backup_cron" model="ir.cron">
            <field name="name">Database Ultimate Backup Lite Scheduler</field>
            <field name="model_id" ref="model_backup_config"/>
            <field name="state">code</field>
            <field name="code">model.run_scheduled_backups()</field>
            <field name="priority">5</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
        </record>

        <!-- Backup Cleanup Cron Job -->
        <record id="backup_cleanup_cron" model="ir.cron">
            <field name="name">Database Ultimate Backup Lite Cleanup</field>
            <field name="model_id" ref="model_backup_config"/>
            <field name="state">code</field>
            <field name="code">
# Clean up old backups for all active configurations
configs = model.search([('active', '=', True)])
for config in configs:
    try:
        config.with_context(manual_execution=False).cleanup_old_backups()
    except Exception as e:
        pass
            </field>
            <field name="priority">10</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Stale /tmp Sweep Cron Job
             Safety net: removes leftover odoo_backup_* / odoo_backup_dump_*
             dirs in the system temp folder that were stranded by a
             SIGKILL'd worker, an Odoo restart mid-backup, or a silent
             rmtree failure under disk pressure. Per-run cleanup in
             backup.job already handles the normal exception path; this is
             belt-and-suspenders for the cases it can't reach. -->
        <record id="backup_temp_sweep_cron" model="ir.cron">
            <field name="name">Database Ultimate Backup Lite - Stale Temp Sweep</field>
            <field name="model_id" ref="model_backup_job"/>
            <field name="state">code</field>
            <field name="code">model._cleanup_stale_temp_files()</field>
            <field name="priority">20</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>